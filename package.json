{
	"name": "deployable-knowledge",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"predev": "drizzle-kit push --force",
		"dev": "vite dev",
		"build": "vite build",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:knowledge-graph": "tsx --test src/lib/server/knowledge-graph/*.test.ts",
		"embeddings:rebuild": "tsx scripts/rebuild-embeddings.ts",
		"graph:rebuild": "tsx scripts/rebuild-knowledge-graph.ts",
		"graph:rebuild:fast": "tsx scripts/rebuild-knowledge-graph.ts --extractor=typescript"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/dompurify": "^3.0.5",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^25.9.2",
		"@types/stemmer": "^1.0.2",
		"@types/stopword": "^2.0.3",
		"drizzle-kit": "^0.31.10",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tsx": "^4.22.4",
		"typescript": "^6.0.2",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@huggingface/transformers": "^4.2.0",
		"@libsql/client": "^0.17.3",
		"@lucide/svelte": "^1.27.0",
		"@types/adm-zip": "^0.5.8",
		"adm-zip": "^0.6.0",
		"bits-ui": "^2.18.1",
		"chokidar": "^5.0.0",
		"dompurify": "^3.4.11",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"markdown-it": "^14.3.0",
		"material-symbols": "^0.44.12",
		"mode-watcher": "^1.1.0",
		"officeparser": "^7.4.0",
		"onnxruntime-node": "^1.24.3",
		"pdf-parse": "^2.4.5",
		"sharp": "^0.34.5",
		"stemmer": "^2.0.1",
		"stopword": "^3.1.5",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.0",
		"tesseract.js": "^7.0.0",
		"wink-bm25-text-search": "^3.1.2"
	},
	"allowScripts": {
		"esbuild@0.18.20": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.0": true,
		"esbuild@0.28.1": true,
		"onnxruntime-node@1.24.3": true,
		"protobufjs@6.11.6": true,
		"protobufjs@7.6.4": true,
		"sharp@0.32.6": true,
		"sharp@0.34.5": true
	}
}
