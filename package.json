{
	"name": "deployable-knowledge",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"test:rerank": "node --import tsx/esm --test ./src/lib/server/rag/mathRerank.unit.test.ts",
		"search:semantic": "node --import tsx/esm ./src/lib/server/rag/semantic-search-harness.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^25.9.2",
		"@types/stemmer": "^1.0.2",
		"@types/stopword": "^2.0.3",
		"drizzle-kit": "^0.31.10",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tsx": "^4.22.4",
		"typescript": "^6.0.2",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@huggingface/transformers": "^4.2.0",
		"@libsql/client": "^0.17.3",
		"@xenova/transformers": "^2.17.2",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"material-symbols": "^0.44.12",
		"scribe.js-ocr": "^0.12.6",
		"sharp": "^0.34.5",
		"stemmer": "^2.0.1",
		"stopword": "^3.1.5",
		"voy-search": "^0.6.3",
		"wink-bm25-text-search": "^3.1.2"
	},
	"allowScripts": {
		"esbuild@0.18.20": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.0": true,
		"onnxruntime-node@1.24.3": true,
		"protobufjs@7.6.4": true,
		"sharp@0.34.5": true
	}
}
